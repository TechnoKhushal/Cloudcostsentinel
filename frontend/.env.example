# Vite embeds this public backend origin at build time. Never put secrets under VITE_*.
# Local development can omit this and defaults to http://127.0.0.1:8000.
# Public frontend configuration only. These values are not secrets.
# VITE_API_BASE_URL=https://cloudcostsentinel.onrender.com
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# Never add a Supabase service-role key, database password or OpenRouter key to VITE_*.
