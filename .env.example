# ==============================================================================
# CloudCost Sentinel Configuration
# Copy this file to .env and adjust variables for your environment.
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# Strands Decider 2B (Policy Decision Layer)
# ------------------------------------------------------------------------------
# Provider mode:
#   "mock"     - Deterministic simulated responses (labeled SIMULATED / DEMO in UI)
#   "http"     - Communicates with a running `strands-decider serve` instance
#   "inprocess"- Runs Decider model directly in Python via PyTorch/HuggingFace (requires local GPU/CPU torch)
DECIDER_PROVIDER=mock
STRANDS_DECIDER_URL=http://127.0.0.1:8000/v1/systemone
DECIDER_MODEL_ID=StrandsAgents/strands-decider-2B-hobson-v19
# Confidence threshold: decisions below this score fallback conservatively to `request_approval`
DECIDER_MIN_CONFIDENCE=0.65

# ------------------------------------------------------------------------------
# Amazon Bedrock (Generative Investigation Layer)
# ------------------------------------------------------------------------------
# Generative mode:
#   "mock"     - Deterministic grounded report generator (labeled SIMULATED / DEMO)
#   "bedrock"  - Live Bedrock invocation via Strands Agents SDK (requires AWS credentials)
BEDROCK_PROVIDER=mock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0
# Optional AWS credentials (if not using standard AWS credential chain ~/.aws/credentials or IAM role)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=your_session_token_if_using_temporary_credentials

# ------------------------------------------------------------------------------
# AWS Cost Explorer (Read-Only Cloud Data Source)
# ------------------------------------------------------------------------------
# Keep false by default to run deterministically with realistic synthetic scenarios
AWS_COST_EXPLORER_ENABLED=false
# AWS_COST_EXPLORER_TIMEZONE=UTC

# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------
DATABASE_PATH=backend/data/sentinel.db
