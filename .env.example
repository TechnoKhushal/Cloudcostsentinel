# ==============================================================================
# CloudCost Sentinel Configuration
# Copy this file to .env and adjust variables for your environment.
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
# Comma-separated or JSON array of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Authentication & Authorization (RBAC)
# ------------------------------------------------------------------------------
# Local development bypass only. For a public synthetic demo, select ENVIRONMENT=demo
# and follow docs/DEMO_DEPLOYMENT.md; public production always requires OIDC.
AUTH_ENABLED=false
# OIDC / OAuth2 JWT configuration (e.g. AWS Cognito, Auth0, Keycloak)
# AUTH_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx
# AUTH_AUDIENCE=your-app-client-id
# AUTH_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx/.well-known/jwks.json

# ------------------------------------------------------------------------------
# Strands Decider 2B (Policy Decision Layer)
# ------------------------------------------------------------------------------
# Provider mode:
#   "mock"     - Deterministic calibrated simulated adapter (labeled SIMULATED in UI)
#   "http"     - Communicates with official `strands-decider serve` process on port 8080
DECIDER_PROVIDER=mock
# In live HTTP mode, points to the external `strands-decider serve` instance (default port 8080)
STRANDS_DECIDER_URL=http://127.0.0.1:8080/v1/systemone
DECIDER_MODEL_ID=StrandsAgents/strands-decider-2B-hobson-v19
# Confidence threshold: decisions below this score fallback conservatively to `request_approval`
DECIDER_MIN_CONFIDENCE=0.65

# ------------------------------------------------------------------------------
# Amazon Bedrock (Generative Investigation Layer)
# ------------------------------------------------------------------------------
# Generative mode:
#   "mock"     - Deterministic grounded report generator (labeled SIMULATED in UI)
#   "bedrock"  - Live Bedrock invocation via Strands Agents SDK (requires AWS credentials)
BEDROCK_PROVIDER=mock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-3-7-sonnet-20250219-v1:0
# Standard AWS credential chain (~/.aws/credentials or IAM instance profile) is preferred
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ------------------------------------------------------------------------------
# AWS Cost Explorer (Read-Only Cloud Data Source)
# ------------------------------------------------------------------------------
# Disabled by default to run deterministically with synthetic scenarios
AWS_COST_EXPLORER_ENABLED=false
AWS_COST_EXPLORER_TIMEZONE=UTC

# ------------------------------------------------------------------------------
# Notification Provider
# ------------------------------------------------------------------------------
# Options: "disabled" | "mock" | "sns"
NOTIFICATION_PROVIDER=mock
# NOTIFICATION_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:cloudcost-alerts

# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------
DATABASE_PATH=backend/data/sentinel.db
# DATABASE_URL is not supported by the current repository and is rejected at startup.
# Production SQLite requires DATABASE_PATH to point to a mounted persistent disk.

# ------------------------------------------------------------------------------
# The fixture route is for isolated local protocol tests only.
ENABLE_TEST_FIXTURE_ENDPOINT=false
